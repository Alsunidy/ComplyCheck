# Copy to .env and fill in. Required: an OpenAI key with available credit.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- Optional overrides -------------------------------------------------
# Preferred judge / vision model. Leave unset to use the built-in fallback
# chain: gpt-4.1-mini -> gpt-4o-mini -> gpt-4.1
# COMPLYCHECK_JUDGE_MODEL=gpt-4.1-mini
# COMPLYCHECK_VISION_MODEL=gpt-4.1-mini

# Controls judged per LLM request, and batches sent in parallel.
# COMPLYCHECK_JUDGE_BATCH_SIZE=6
# COMPLYCHECK_JUDGE_CONCURRENCY=6

# Base URL the Streamlit frontend calls.
# COMPLYCHECK_API_URL=http://localhost:8000

# Arabic-capable TTF used for the Arabic PDF report. Auto-detected from the
# system (Arial on Windows) when unset.
# COMPLYCHECK_ARABIC_FONT=C:\Windows\Fonts\arial.ttf
